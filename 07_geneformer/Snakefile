rule predict_npc:
    input:
        model=MODEL_DIR / '{task}/{split}/{model}',
        tokens=ancient(TOKENS_DIR)
    output:
        directory(expand(
            '{{dir}}/{{task}}/{{split,split_\d}}/{{model,model_\d}}/npc_predictions/{mc}',
            mc=[f'mc_{i}' for i in range(1)]
        ))
    params:
        slurm__account='p31841',
        slurm__partition='gengpu',
        slurm__hours=48,
        slurm__cores=16,
        slurm__mem=60,
        slurm__gres='gpu:a100:1',
    shell:
        'python scripts/run_predict_npc.py "{input.model}" "{input.tokens}" "{wildcards.task}" "{wildcards.split}" "{output[0]}"'

