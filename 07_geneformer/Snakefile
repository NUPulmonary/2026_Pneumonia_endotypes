rule train:
    input:
        tokens=ancient(TOKENS_DIR)
    output:
        directory(MODEL_DIR / '{task}/{split}/{model}')
    params:
        slurm__account='p31841',
        slurm__partition='gengpu',
        slurm__hours=12,
        slurm__cores=16,
        slurm__mem=60,
        slurm__gres='gpu:a100:1',
    shell:
        'python scripts/run_train.py "{input.tokens}" "{wildcards.task}" "{wildcards.split}" "{output}"'

rule tokenize:
    input:
        loom=LOOMS_DIR,
        labels=ancient(common_data.SC_LABELS)
    output:
        directory(TOKENS_DIR)
    params:
        slurm__account='b1038',
        slurm__partition='b1038',
        slurm__hours=2,
        slurm__cores=16,
        slurm__mem=60,
    shell:
        'python scripts/run_tokenize.py "{input.loom}" "{input.labels}" "{output}"'

rule loom:
    input:
        data=common_data.SC_RAW,
        labels=ancient(common_data.SC_LABELS)
    output:
        directory(LOOMS_DIR)
    params:
        slurm__account='b1038',
        slurm__partition='b1038',
        slurm__hours=2,
        slurm__cores=16,
        slurm__mem=160,
    shell:
        'python scripts/write_loom.py "{input.data}" "{input.labels}" "{output}"'
